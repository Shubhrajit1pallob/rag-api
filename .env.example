# Two different API keys. Generate each with: openssl rand -hex 32
# The admin key can ingest/delete documents and query; the query key can only query.
# The portfolio's public web process gets ONLY the query key.
RAG_QUERY_API_KEY=generate-with-openssl-rand-hex-32
RAG_ADMIN_API_KEY=generate-a-different-one-with-openssl-rand-hex-32
VOYAGE_API_KEY=your-voyage-api-key
ANTHROPIC_API_KEY=your-anthropic-api-key
VOYAGE_EMBEDDING_MODEL=voyage-3
CLAUDE_MODEL=claude-haiku-4-5-20251001
# Supabase SESSION pooler (port 5432, IPv4). User is rag_api.<project-ref>.
DATABASE_URL=postgresql://rag_api.<project-ref>:<password>@<pooler-host>:5432/postgres?sslmode=require
EMBEDDING_DIMENSIONS=1024
DB_POOL_MIN_SIZE=1
DB_POOL_MAX_SIZE=5
MAX_CHUNK_SIZE=400
RETRIEVAL_TOP_K=5
# Drop retrieved chunks with similarity (1 - cosine distance) below this; 0 = off
MIN_SIMILARITY=0.0
# Hard spend cap: total /query calls per UTC day, across all callers (>= 1).
# Over the limit -> 429 with Retry-After. To effectively remove the cap, set a big number.
DAILY_QUERY_LIMIT=300
# Cap on Claude's answer length (tokens) and on question length (characters).
CLAUDE_MAX_TOKENS=400
MAX_QUESTION_CHARS=500
# Timeout (seconds) and max retries for Voyage and Anthropic calls.
UPSTREAM_TIMEOUT_SECONDS=20
UPSTREAM_MAX_RETRIES=1
