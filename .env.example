RAG_API_KEY=change-me
VOYAGE_API_KEY=your-voyage-api-key
ANTHROPIC_API_KEY=your-anthropic-api-key
VOYAGE_EMBEDDING_MODEL=voyage-3
CLAUDE_MODEL=claude-haiku-4-5-20251001
# Supabase SESSION pooler (port 5432, IPv4). User is rag_api.<project-ref>.
DATABASE_URL=postgresql://rag_api.<project-ref>:<password>@<pooler-host>:5432/postgres?sslmode=require
EMBEDDING_DIMENSIONS=1024
DB_POOL_MIN_SIZE=1
DB_POOL_MAX_SIZE=5
MAX_CHUNK_SIZE=400
RETRIEVAL_TOP_K=5
# Drop retrieved chunks with similarity (1 - cosine distance) below this; 0 = off
MIN_SIMILARITY=0.0
